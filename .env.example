# Copy to .env.local and fill in real values. Do not commit .env.local.

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---------- Payload ----------
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public-facing URL Payload uses to build absolute links (og:image, password reset
# emails, etc). Leave unset locally to let it default to localhost. MUST be set
# in production (Vercel env vars, Production scope) — without it Payload falls
# back to "http://localhost..." in SSR meta tags and the admin React tree fails
# to hydrate cleanly.
PAYLOAD_PUBLIC_SERVER_URL=https://nepali-threads-one.vercel.app

# ---------- Object storage (Cloudflare R2, S3-compatible) ----------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nepali-threads-media
S3_REGION=auto

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_...

# ---------- Local LLM (Ollama on the desktop, over Tailscale) ----------
OLLAMA_ENDPOINT=http://desktop.tailnet-name.ts.net:11434
OLLAMA_MODEL=nepali-coder
