# Copy to .env.local and fill in real values. Do not commit .env.local.

# ---------- Database (Neon Postgres) ----------
DATABASE_URL=postgres://user:password@host/dbname?sslmode=verify-full

# ---------- Payload ----------
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=

# Public storefront URL used for checkout redirects, verification links, and SEO.
# Use http://localhost:3000 locally and the canonical domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public-facing URL Payload uses to build absolute links (og:image, password reset
# emails, etc). Leave unset locally to let it default to localhost. MUST be set
# in production (Vercel env vars, Production scope) — without it Payload falls
# back to "http://localhost..." in SSR meta tags and the admin React tree fails
# to hydrate cleanly.
PAYLOAD_PUBLIC_SERVER_URL=https://nepali-threads.com

# ---------- Object storage (Cloudflare R2, S3-compatible) ----------
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=nepali-threads-media
S3_REGION=auto

# ---------- Stripe ----------
STRIPE_SECRET_KEY=sk_test_...
# Signing secret printed by `stripe listen` locally or configured on the
# production webhook endpoint. This is not the Stripe API secret key.
STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- Email (Resend) ----------
RESEND_API_KEY=re_...
# From-address Resend sends customer + admin emails as. Must be on a
# domain verified in Resend. Example: hello@nepali-threads.com
RESEND_FROM_EMAIL=
# Comma-separated list of admin emails that get a "new order" notification
# every time a Stripe payment lands. Leave blank to disable admin notifications.
# Example: dad@example.com,sister@example.com,neal@example.com
ADMIN_NOTIFICATION_EMAILS=
