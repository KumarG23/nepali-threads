#!/usr/bin/env sh
# Block commits whose message starts with "[local]", "[kimi]", or "[codex]"
# if the staged diff touches any path matching .localllm-blocklist. The
# local LLM is the intended author of these commits, and blocklisted
# paths are reserved for the senior reviewer (Claude Code).
#
# Blocklist pattern syntax:
#   foo/bar.ts   — exact file
#   foo/bar/**   — anything under foo/bar/, recursively

set -e

commit_msg_file="$1"
first_line="$(head -n1 "$commit_msg_file")"

case "$first_line" in
  "[local]"*|"[kimi]"*|"[codex]"*) ;;
  *) exit 0 ;;
esac

repo_root="$(git rev-parse --show-toplevel)"
blocklist_file="$repo_root/.localllm-blocklist"

if [ ! -f "$blocklist_file" ]; then
  exit 0
fi

staged="$(git diff --cached --name-only --diff-filter=ACMRTD)"
if [ -z "$staged" ]; then
  exit 0
fi

violations=""
while IFS= read -r pattern; do
  case "$pattern" in
    "#"*|"") continue ;;
  esac
  pattern="$(printf '%s' "$pattern" | sed 's/[[:space:]]*$//')"
  [ -z "$pattern" ] && continue

  while IFS= read -r path; do
    case "$pattern" in
      */\*\*)
        # Recursive glob: strip trailing /** and prefix-match.
        prefix="${pattern%/\*\*}/"
        case "$path" in
          "$prefix"*) violations="$violations
  $path  (matches $pattern)" ;;
        esac
        ;;
      *)
        if [ "$path" = "$pattern" ]; then
          violations="$violations
  $path  (matches $pattern)"
        fi
        ;;
    esac
  done <<EOF
$staged
EOF
done < "$blocklist_file"

if [ -n "$violations" ]; then
  printf '\n[local] commits are not allowed to touch blocklist paths.\n' >&2
  printf 'Violations:%s\n\n' "$violations" >&2
  printf 'Either remove these files from the commit, drop the [local] prefix,\n' >&2
  printf 'or have Claude Code take over the change.\n' >&2
  exit 1
fi

exit 0
